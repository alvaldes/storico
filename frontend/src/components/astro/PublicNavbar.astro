---
import LangToggle from './LangToggle.astro';
import { ThemeToggle } from '../react/ThemeToggle';
import { MobileNav } from '../react/MobileNav';
import GitHubIcon from './GitHubIcon.astro';
import { useTranslations, localizedPath, type Locale } from '@/i18n/utils';
import { PublicUserMenu, type PublicNavUser } from '../react/PublicUserMenu';

import type { MobileNavLink } from '../react/MobileNav';

export interface Props {
  locale: Locale;
  currentPath: string;
  langToggleHref: string;
  navLinks: Array<{ href: string; label: string }>;
  mobileNavLinks?: MobileNavLink[];
  ctaLink: { href: string; label: string };
  isLoggedIn: boolean;
  /** Serialized session user; null/undefined when signed out. */
  user?: PublicNavUser | null;
}

const { locale, currentPath, langToggleHref, navLinks, mobileNavLinks, ctaLink, isLoggedIn, user } = Astro.props;
const t = useTranslations(locale);
const L = (path: string) => localizedPath(path, locale);
---

<header class="border-b border-(--color-border)" data-public-nav>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 md:px-8 lg:px-20 lg:py-5">
    <!-- Left: Logo -->
    <!-- `flex` for the same reason as the avatar trigger below: a block wrapper would put
         the inline-flex link on a text baseline and lift it off the row's centre. -->
    <div class="flex">
      <a href={L('/')} class="inline-flex items-center gap-2.5 no-underline">
        <img src="/favicon.svg" alt="" class="h-7 w-auto md:h-8" />
        <span class="text-xl font-extrabold text-(--color-primary-600) dark:text-(--color-text) md:text-[22px]">{t.app.name}</span>
      </a>
    </div>

    <!-- Center: Desktop nav links -->
    <nav class="hidden lg:flex items-center gap-8" data-nav="public">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            data-nav-link
            class={`text-[15px] font-medium no-underline transition-colors ${
              currentPath === href
                ? 'text-(--color-text) font-semibold'
                : 'text-(--color-text-secondary) hover:text-(--color-text)'
            }`}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <!-- Right: Controls -->
    <div class="flex items-center gap-1">
      <!-- Lang toggle -->
      <LangToggle href={langToggleHref} locale={locale} />

      <!-- Theme toggle -->
      <ThemeToggle client:idle />

      <!-- GitHub -->
      <a
        href="https://github.com/alvaldes/storico"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md p-1.5 text-(--color-text-secondary) hover:text-(--color-text) hover:bg-(--color-surface-secondary) transition-colors"
        aria-label="GitHub repository"
        title="GitHub repository"
      >
        <GitHubIcon class="h-5 w-5" />
      </a>

      <!-- Mobile nav (Sheet island, hydrated on idle) -->
      <MobileNav
        client:idle
        links={mobileNavLinks ?? navLinks}
        brandName={t.app.name}
        locale={locale}
        langToggleHref={langToggleHref}
        cta={ctaLink}
        activePath={currentPath}
        user={user ?? null}
      />

      <!-- Signed in: avatar dropdown replaces the Dashboard CTA (desktop only); signed out keeps the CTA -->
      {user ? (
        // `flex` and not `block`: a block wrapper puts the inline-flex trigger on a text
        // baseline, which lifts it ~4px above the row its siblings are centred in.
        <div class="hidden lg:flex p-1.5">
          <PublicUserMenu client:idle locale={locale} user={user} />
        </div>
      ) : (
        <a
          href={ctaLink.href}
          class="hidden lg:inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground no-underline shadow transition-all hover:bg-primary/80"
        >
          {ctaLink.label}
        </a>
      )}
    </div>
  </div>
</header>

<!-- Publish the header's own height as --public-nav-h so portaled overlays (the mobile
     sheet) can align their top edge with the header's bottom border instead of hardcoding
     it. Bundled module: re-reads after view transitions and on resize; the resize listener
     is registered idempotently because a view transition re-runs the module. -->
<script>
  function updatePublicNavHeight() {
    const header = document.querySelector('header[data-public-nav]');
    if (header) {
      document.documentElement.style.setProperty('--public-nav-h', `${header.offsetHeight}px`);
    }
  }

  updatePublicNavHeight();

  // Both registrations are guarded: a view transition re-runs this module, so an
  // unconditional addEventListener would stack one more listener per navigation.
  if (!document.documentElement.dataset.publicNavBound) {
    document.documentElement.dataset.publicNavBound = 'true';
    document.addEventListener('astro:after-swap', updatePublicNavHeight);
    window.addEventListener('resize', updatePublicNavHeight);
  }
</script>
