---
/**
 * The landing features band. Composition follows inkdrop.app's "positioning" section:
 * one raised container holds a headline band on top and a band of joined columns below,
 * separated by 1px lines rather than gaps — no floating cards.
 *
 * The column band keeps the reference's 280px basis and scrolls horizontally with snap
 * below its natural width, so the three features slide instead of stacking.
 *
 * Written in Astro, not React: nothing here has state, handlers or props that change, and
 * ADR-001 limits React islands to components that need interactivity. The icons are inlined
 * because `lucide-react` is a React package and cannot be rendered from an `.astro` file;
 * the path data below is lucide's own (ISC).
 */
interface FeatureItem {
  title: string;
  description: string;
  icon: 'zap' | 'table' | 'share2';
}

interface Props {
  /** Small pill above the heading. It labels this section, not the hero. */
  eyebrow: string;
  title: string;
  lead: string;
  items: FeatureItem[];
}

const { eyebrow, title, lead, items } = Astro.props;
---

<div class="overflow-hidden rounded-2xl bg-(--color-surface) shadow-card">
  <!-- Headline band. The reference reserves 300px on the right here for its illustration;
       with no asset to put there, the band keeps the 28px it uses on every other side. -->
  <div class="border-b border-(--color-border) px-7 py-7">
    <!-- `flex w-fit` rather than `inline-flex`: as a block-level flex box its margin-bottom
         actually separates it from the heading, which it would not do inline. -->
    <span
      class="mb-4 flex w-fit items-center rounded-full border border-(--color-primary-200) bg-(--color-primary-50) px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-(--color-primary-600) dark:border-(--color-primary-400) dark:bg-(--color-primary-950) dark:text-(--color-primary-400)"
    >
      {eyebrow}
    </span>
    <h2
      class="text-2xl font-extrabold tracking-[-0.5px] text-(--color-text) md:text-4xl md:tracking-[-1px]"
      style="font-family: 'Space Grotesk', sans-serif;"
    >
      {title}
    </h2>
    <p class="mt-4 max-w-[52ch] text-lg leading-[1.5] text-(--color-text-secondary) opacity-85 md:text-xl">
      {lead}
    </p>
  </div>

  <!-- Column band. `scroll-snap-type: x proximity` and the 280px basis are the reference's:
       the columns fit side by side at `lg` and slide below it. -->
  <div class="flex snap-x snap-proximity overflow-x-auto">
    {
      items.map((item) => (
        <div class="flex grow shrink-0 basis-[280px] flex-col gap-2 border-l border-(--color-border) p-5 first:border-l-0 lg:p-6">
          <div class="flex h-[100px] items-center justify-center text-(--color-text)">
            {item.icon === 'zap' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-12 w-12"
                aria-hidden="true"
              >
                <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
              </svg>
            )}
            {item.icon === 'table' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-12 w-12"
                aria-hidden="true"
              >
                <path d="M12 3v18" />
                <rect width="18" height="18" x="3" y="3" rx="2" />
                <path d="M3 9h18" />
                <path d="M3 15h18" />
              </svg>
            )}
            {item.icon === 'share2' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-12 w-12"
                aria-hidden="true"
              >
                <circle cx="18" cy="5" r="3" />
                <circle cx="6" cy="12" r="3" />
                <circle cx="18" cy="19" r="3" />
                <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" />
                <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />
              </svg>
            )}
          </div>

          <h3 class="text-xl font-semibold text-(--color-text)">{item.title}</h3>
          <p class="text-sm leading-5 text-(--color-text-secondary)">{item.description}</p>
        </div>
      ))
    }
  </div>
</div>
