---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { Separator } from '@/components/ui/separator';
import { useTranslations, type Locale } from '@/i18n/utils';
import { config } from '@/lib/config';

const locale = (Astro.params.locale as Locale) || 'en';
const t = useTranslations(locale);

/**
 * The endpoints this page documents.
 *
 * Hand-written, because the page is prose the backend cannot generate — but no longer
 * unchecked: `src/i18n/__tests__/api-docs-copy.test.ts` composes the paths the routers
 * declare, out of `backend/src/storico/api/routes/*.py`, and fails for any path listed
 * here that no router serves. This list once advertised a batch endpoint that has never
 * existed in this codebase, plus two extraction paths the API had already left behind.
 * The guard also fails on a retired path mentioned anywhere in this file, comments
 * included: prose that names a dead route is what gets copied next.
 *
 * Paths are the ones FastAPI publishes in `/openapi.json`, which is why the extraction
 * route keeps its trailing slash.
 */
const endpoints = [
  {
    method: 'POST',
    path: '/api/v1/workspaces/{workspace_id}/extract/',
    description: t.pages.api.endpoint_extract_desc,
  },
  {
    method: 'GET',
    path: '/api/v1/workspaces/{workspace_id}/extract/status/{extraction_id}',
    description: t.pages.api.endpoint_status_desc,
  },
];

// Both badges spelled out literally: Tailwind reads class names out of the source text, so
// the pair has to stay visible here rather than be built from the method name.
const methodBadgeClass = (method: string) =>
  method === 'POST'
    ? 'bg-(--color-method-post-bg) text-(--color-method-post-text)'
    : 'bg-(--color-method-get-bg) text-(--color-method-get-text)';
---

<PublicLayout
  locale={locale}
  title={`${t.app.name} — ${t.pages.api.title}`}
  description={t.pages.api.description}
>
  <div class="mx-auto max-w-3xl px-4 py-4 md:px-8 lg:px-0 lg:py-8">
    <h1
      class="mb-8 text-3xl font-extrabold tracking-[-0.5px] text-(--color-text) md:text-4xl lg:text-5xl"
      style="font-family: 'Space Grotesk', sans-serif;"
    >
      {t.pages.api.title}
    </h1>

    <div class="space-y-6 text-base leading-[1.7] text-(--color-text-secondary) md:text-lg">
      <p class="text-xs text-(--color-text-tertiary) uppercase">
        {t.pages.api.last_updated}
      </p>
      <p class="text-lg font-medium text-(--color-text)">
        {t.pages.api.intro}
        <a href={`${config.apiUrl}/docs`} target="_blank" rel="noopener noreferrer"
           class="inline-link"
           aria-label={t.pages.api.aria_openapi}>
          <code class="rounded bg-(--color-surface-secondary) px-1.5 py-0.5 text-sm font-mono text-(--color-text) underline decoration-dotted underline-offset-2 transition-colors hover:text-(--color-primary-600)">/docs</code>
        </a>
        {t.pages.api.intro_end}
      </p>
      <Separator/>

      <h2 class="text-xl font-bold text-(--color-text)">{t.pages.api.auth_title}</h2>
      <p>{t.pages.api.auth}</p>

      <h2 class="text-xl font-bold text-(--color-text)">{t.pages.api.endpoints_title}</h2>

      <div class="rounded-lg border border-(--color-border) divide-y divide-(--color-border)">
        {
          endpoints.map((endpoint) => (
            <div class="p-4">
              <div class="flex items-center gap-3 mb-1">
                <span
                  class={`rounded px-2 py-0.5 text-xs font-bold ${methodBadgeClass(endpoint.method)}`}
                >
                  {endpoint.method}
                </span>
                <code class="text-sm font-mono text-(--color-text)">{endpoint.path}</code>
              </div>
              <p class="text-sm text-(--color-text-secondary)">{endpoint.description}</p>
            </div>
          ))
        }
      </div>

      <p class="pt-4">
        {t.pages.api.footer}
        <a href={`${config.apiUrl}/docs`} target="_blank" rel="noopener noreferrer"
           class="inline-link"
           aria-label={t.pages.api.aria_swagger}>
          <code class="rounded bg-(--color-surface-secondary) px-1.5 py-0.5 text-sm font-mono text-(--color-text) underline decoration-dotted underline-offset-2 transition-colors hover:text-(--color-primary-600)">/docs</code>
        </a>
        {t.pages.api.footer_end}
      </p>
    </div>
  </div>
</PublicLayout>
