---
import MainLayout from '@/layouts/MainLayout.astro';
import { KanbanBoard } from '@/components/react/KanbanBoard';
import { useTranslations, type Locale } from '@/i18n/utils';

const locale = (Astro.params.locale as Locale) || 'en';
const t = useTranslations(locale);

// Deep link entry (feature ``view-in-kanban``): a "View in Kanban" link lands
// here with `?project=<id>&story=<id>`. The page output is SSR
// (`astro.config.mjs`: `output: 'server'` + Vercel adapter), so the request's
// query params are read here and handed to the island as initial values; the
// board seeds its cascade from them.
const projectId = Astro.url.searchParams.get('project');
const storyId = Astro.url.searchParams.get('story');
---

<MainLayout locale={locale}>
  <div slot="head">
    <title>{t.app.name} — {t.nav.kanban}</title>
  </div>

  <KanbanBoard client:load locale={locale} initialProjectId={projectId} initialStoryId={storyId} />
</MainLayout>
