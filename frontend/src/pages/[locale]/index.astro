---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { useTranslations, localizedPath, type Locale } from '@/i18n/utils';
import { FaqAccordion } from '@/components/react/FaqAccordion';
import { FeatureCards } from '@/components/react/FeatureCards';

import { getSession } from 'auth-astro/server';
import { config } from '@/lib/config';
import { demoEmbedUrl, demoTargetOrigin } from '@/lib/demo-embed';

const locale = (Astro.params.locale as Locale) || 'en';
const t = useTranslations(locale);
const L = (path: string) => localizedPath(path, locale);

const session = await getSession(Astro.request);
const isLoggedIn = !!session?.user;

const demoSrc = demoEmbedUrl(config.demoUrl, locale);
const demoOrigin = demoTargetOrigin(config.demoUrl);

const featureCards = [
  { title: t.landing.features.card_1_title, description: t.landing.features.card_1_desc, icon: 'zap', color: 'blue' as const },
  { title: t.landing.features.card_2_title, description: t.landing.features.card_2_desc, icon: 'table', color: 'green' as const },
  { title: t.landing.features.card_3_title, description: t.landing.features.card_3_desc, icon: 'share2', color: 'orange' as const },
];

const faqItems = [
  { question: t.landing.faq.q1, answer: t.landing.faq.a1 },
  { question: t.landing.faq.q2, answer: t.landing.faq.a2 },
  { question: t.landing.faq.q3, answer: t.landing.faq.a3 },
  { question: t.landing.faq.q4, answer: t.landing.faq.a4 },
  { question: t.landing.faq.q5, answer: t.landing.faq.a5 },
  { question: t.landing.faq.q6, answer: t.landing.faq.a6 },
];
---

<PublicLayout
  locale={locale}
  title={`${t.app.name} — ${t.app.tagline}`}
  description={t.app.tagline}
>
  <!-- ════════════════════════════════════════════ -->
  <!-- HERO                                         -->
  <!-- ════════════════════════════════════════════ -->
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-20">
    <section class="flex flex-wrap justify-around items-center gap-16 py-16 lg:flex-row lg:py-[100px]">
      <!-- Left -->
      <div class="relative flex w-full max-w-[565px] flex-col gap-6">
        <!-- Background watermark -->
        <img
          src="/favicon.svg"
          alt=""
          class="pointer-events-none absolute left-1/2 top-1/2 h-full w-auto -translate-x-1/2 -translate-y-1/2 opacity-[0.20] blur-[50px]"
        />

        <!-- Badge -->
        <span
          class="inline-flex w-fit items-center rounded-full border border-(--color-primary-200) dark:border-(--color-primary-400) bg-(--color-primary-50) dark:bg-(--color-primary-950) px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-(--color-primary-600) dark:text-(--color-primary-400)"
        >
          {t.landing.hero.badge}
        </span>

        <h1
          class="text-[2rem] font-[800] leading-[1.15] tracking-[-1px] text-(--color-text) md:text-[3rem] lg:text-[52px] lg:tracking-[-1.5px]"
          style="font-family: 'Space Grotesk', sans-serif;"
        >
          {t.landing.hero.title}
        </h1>

        <p class="text-base leading-[1.6] text-(--color-text-secondary) md:text-lg">
          {t.landing.hero.subtitle}
        </p>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={L(isLoggedIn ? '/dashboard' : '/login')}
            class="inline-flex items-center justify-center rounded-lg bg-(--color-primary-600) px-7 py-3.5 text-base font-semibold text-(--color-inverse-text) no-underline shadow-primary-sm transition-all hover:bg-(--color-primary-700)"
          >
            {isLoggedIn ? t.nav.dashboard : t.landing.hero.cta_primary}
          </a>
          <a
            href="#demo"
            class="inline-flex items-center justify-center rounded-lg border border-(--color-border) bg-(--color-surface) px-7 py-3.5 text-base font-semibold text-(--color-text) no-underline transition-all hover:bg-(--color-surface-secondary)"
          >
            {t.landing.hero.cta_secondary}
          </a>
        </div>
      </div>

      <!-- Right: Phone Mockup -->
      <div
        class="hidden lg:flex h-[480px] w-[260px] shrink-0 flex-col overflow-hidden rounded-[28px] border-[3px] border-(--color-mockup-border) bg-(--color-mockup-bg) shadow-phone sm:h-[540px] sm:w-[290px] sm:rounded-[32px] sm:border-[4px] lg:h-[590px] lg:w-[310px] lg:rounded-[36px]"
      >
        <!-- Status bar -->
        <div class="flex h-10 items-center justify-between px-5 sm:h-11 sm:px-6">
          <span class="text-[12px] font-semibold text-(--color-mockup-text) sm:text-[13px]">9:41</span>
        </div>

        <!-- App header -->
        <div class="flex h-11 items-center justify-between bg-(--color-mockup-header) px-4 sm:h-13 sm:px-5">
          <span class="text-sm font-bold text-(--color-mockup-text) sm:text-base">{t.app.name}</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-(--color-mockup-text)"
          >
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </div>

        <!-- App content -->
        <div class="flex flex-col gap-3 px-4 py-3 sm:gap-4 sm:px-5 sm:py-4">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-(--color-mockup-label) sm:text-[12px]">
            User Story
          </span>

          <div class="flex h-12 items-center rounded-xl bg-(--color-mockup-header) px-3 sm:h-14 sm:px-4">
            <span class="text-[12px] text-(--color-mockup-muted) sm:text-[13px]">As a user, I want to...</span>
          </div>

          <button
            class="flex h-10 w-full items-center justify-center rounded-lg bg-(--color-primary-600) text-xs font-semibold text-(--color-inverse-text) transition-colors hover:bg-(--color-primary-700) sm:h-11 sm:text-sm"
          >
            Extraer tareas
          </button>

          <span class="text-[11px] font-semibold uppercase tracking-wider text-(--color-mockup-label) sm:text-[12px]">
            Tareas generadas
          </span>

          <!-- Task 1 -->
          <div class="flex flex-col gap-2 rounded-lg border border-(--color-mockup-task-border) bg-(--color-mockup-task-bg) p-2.5 sm:p-3">
            <span class="text-[12px] font-medium text-(--color-mockup-text) sm:text-[13px]">1. Set up auth endpoint</span>
            <div class="flex gap-1.5">
              <span
                class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-800 sm:px-2.5 sm:py-1 sm:text-[11px]"
              >
                backend
              </span>
              <span
                class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-medium text-blue-800 sm:px-2.5 sm:py-1 sm:text-[11px]"
              >
                api
              </span>
            </div>
          </div>

          <!-- Task 2 -->
          <div class="flex flex-col gap-2 rounded-lg border border-(--color-mockup-task-border) bg-(--color-mockup-task-bg) p-2.5 sm:p-3">
            <span class="text-[12px] font-medium text-(--color-mockup-text) sm:text-[13px]">2. Create login form UI</span>
            <div class="flex gap-1.5">
              <span
                class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-medium text-blue-800 sm:px-2.5 sm:py-1 sm:text-[11px]"
              >
                frontend
              </span>
              <span
                class="inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-medium text-sky-800 sm:px-2.5 sm:py-1 sm:text-[11px]"
              >
                ui/ux
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Live demo: embeds the storico-live-demo project, whose page brings its own
           fake-Safari browser chrome, so the iframe needs no frame of its own.
           flex-wrap on the section + w-full here keep this below the existing
           content at every breakpoint instead of beside the phone mockup. -->
      <div id="demo" class="w-full">
        <!-- Cross-origin consequence (accepted, not a bug): while the demo lives on
             another origin (PUBLIC_DEMO_URL), localStorage['theme'] is NOT shared
             with the landing, so the demo follows the visitor's system preference. -->
        <div class="demo-frame-box overflow-hidden rounded-2xl border border-(--color-border) bg-(--color-surface)">
          <iframe
            src={demoSrc}
            title={`${t.app.name}: ${t.landing.hero.subtitle}`}
            class="demo-frame block h-[420px] w-full lg:h-[720px]"
            loading="lazy"
            data-target-origin={demoOrigin}
          ></iframe>
        </div>
      </div>
    </section>
  </div>

  <!-- ════════════════════════════════════════════ -->
  <!-- FEATURES                                     -->
  <!-- ════════════════════════════════════════════ -->
  <div class="mx-auto max-w-7xl px-4 md:px-10 lg:px-20">
    <section class="flex flex-col items-center gap-10 py-12 md:gap-14 md:py-[50px]">
      <div class="flex max-w-2xl flex-col items-center gap-4">
        <h2
          class="text-center text-2xl font-extrabold tracking-[-0.5px] text-(--color-text) md:text-4xl md:tracking-[-1px]"
          style="font-family: 'Space Grotesk', sans-serif;"
        >
          {t.landing.features.title}
        </h2>
        <p class="text-center text-sm text-(--color-text-secondary) md:text-base">
          {t.landing.features.subtitle}
        </p>
      </div>

      <FeatureCards client:idle cards={featureCards} />
    </section>
  </div>

  <!-- ════════════════════════════════════════════ -->
  <!-- FAQ                                         -->
  <!-- ════════════════════════════════════════════ -->
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-20">
    <section class="flex flex-col items-center gap-10 py-12 md:gap-14 md:py-[50px]">
      <div class="flex max-w-2xl flex-col items-center gap-4">
        <h2
          class="text-center text-2xl font-extrabold tracking-[-0.5px] text-(--color-text) md:text-4xl md:tracking-[-1px]"
          style="font-family: 'Space Grotesk', sans-serif;"
        >
          {t.landing.faq.title}
        </h2>
        <p class="text-center text-sm text-(--color-text-secondary) md:text-base">
          {t.landing.faq.subtitle}
        </p>
      </div>

      <FaqAccordion client:idle items={faqItems} />
    </section>
  </div>

  <style>
    /* Below `lg` the demo needs more viewport than a phone gives it: at the box
       height its story card — the thing that types itself, and the whole point of
       the embed — falls under the frame's bottom edge.

       The fix is a zoom on the iframe, not a crop and not a change to the demo.
       The frame is laid out at 1/zoom of the box and scaled back into it, so the
       nested browsing context gets a larger layout viewport (and lays out for a
       wider page) while the box the visitor sees keeps its size. `transform` is
       what makes that possible without touching the child: it does not affect
       layout, so the demo's own `100dvh` embedded frame still fills whatever box
       it is handed, and hit-testing follows the transform, so the demo stays
       interactive.

       The cost is legibility: text renders at --demo-zoom of its size. That is
       the whole trade, and it is why this only applies below `lg`. */
    @media (max-width: 1023.98px) {
      .demo-frame-box {
        height: 420px;
      }

      .demo-frame {
        --demo-zoom: 0.72;
        width: calc(100% / var(--demo-zoom));
        height: calc(420px / var(--demo-zoom));
        transform: scale(var(--demo-zoom));
        transform-origin: top left;
      }
    }
  </style>

  <script>
    // Forward the demo bridge's "leave" signals (see @/lib/demo-embed). Astro's
    // ClientRouter re-runs `astro:page-load` on every navigation but does not
    // re-execute this module script, so the wiring happens here, once per page
    // load. Each swap inserts a fresh <iframe> (a new element node), and the
    // WeakSet keys on the element itself, so every iframe is wired exactly once;
    // the teardown is discarded because a navigation drops the old document
    // together with its listeners — nothing leaks.
    import { attachDemoLeaveForwarding } from '@/lib/demo-embed';

    const wired = new WeakSet<HTMLIFrameElement>();

    function wireDemoEmbed() {
      const iframe = document.querySelector<HTMLIFrameElement>(
        '#demo iframe[data-target-origin]',
      );
      if (!iframe || wired.has(iframe)) return;
      attachDemoLeaveForwarding(iframe);
      wired.add(iframe);
    }

    document.addEventListener('astro:page-load', wireDemoEmbed);
  </script>
</PublicLayout>
