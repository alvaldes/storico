---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { useTranslations, type Locale } from '@/i18n/utils';
import { StatusPanel } from '@/components/react/StatusPanel';

const locale = (Astro.params.locale as Locale) || 'en';
const t = useTranslations(locale);

// This page no longer fetches anything: the document must paint the moment the link is
// clicked, whether or not the backend answers. The old design awaited
// `${config.apiUrl}/api/v1/health/services` right here with a 10 s abort, which — with
// `output: 'server'` — blocked the whole HTML document on the backend (measured TTFB
// 2.19–2.54 s, up to 10 s of blank page with the backend down). The fetch moved to the
// `StatusPanel` island via the same-origin endpoint `/api/health/services`, and every
// row/banner rule now lives in that island, still guarded by
// `status-probes-mirror.test.ts`.
---

<PublicLayout
  locale={locale}
  title={`${t.app.name} — ${t.pages.status.title}`}
  description={t.pages.status.description}
>
  <div class="mx-auto max-w-3xl px-4 py-4 md:px-8 lg:px-0 lg:py-8">
    <h1
      class="mb-8 text-3xl font-extrabold tracking-[-0.5px] text-(--color-text) md:text-4xl lg:text-5xl"
      style="font-family: 'Space Grotesk', sans-serif;"
    >
      {t.pages.status.title}
    </h1>

    <noscript>
      <p class="mb-6 text-base text-(--color-text-secondary)">
        {t.pages.status.no_js}
      </p>
    </noscript>

    <div class="space-y-6 text-base leading-[1.7] text-(--color-text-secondary) md:text-lg">
      <StatusPanel locale={locale} client:load />
    </div>
  </div>
</PublicLayout>
