---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { useTranslations, type Locale } from '@/i18n/utils';
import { config } from '@/lib/config';
import {
  HEALTH_SERVICES_PATH,
  parseServicesHealth,
  serviceStatus,
  type ServicesHealth,
  type ServiceStatus,
} from '@/lib/health';

const locale = (Astro.params.locale as Locale) || 'en';
const t = useTranslations(locale);

let health: ServicesHealth | null = null;
let fetchError: string | null = null;

try {
  // The diagnostics route, not `/health`: this page renders a row per service, and only
  // this document carries them. See `@/lib/health` for the regression that caused.
  const response = await fetch(`${config.apiUrl}${HEALTH_SERVICES_PATH}`, {
    signal: AbortSignal.timeout(10_000),
  });
  if (response.ok) {
    health = parseServicesHealth(await response.json());
    if (!health) fetchError = 'Unexpected health payload';
  } else {
    fetchError = `HTTP ${response.status}`;
  }
} catch (e) {
  fetchError = e instanceof Error ? e.message : 'Connection failed';
}

const allOk = health?.status === 'ok';

let bannerTitle: string;
let bannerDesc: string;
let bannerState: 'ok' | 'degraded' | 'down';

if (!health) {
  bannerTitle = t.pages.status.down_title;
  bannerDesc = fetchError ? `${t.pages.status.down_desc} (${fetchError})` : t.pages.status.down_desc;
  bannerState = 'down';
} else if (allOk) {
  bannerTitle = t.pages.status.all_operational;
  bannerDesc = t.pages.status.running_normally;
  bannerState = 'ok';
} else {
  bannerTitle = t.pages.status.degraded_title;
  bannerDesc = t.pages.status.degraded_desc;
  bannerState = 'degraded';
}

const statusDotClass = (state: string) => {
  if (state === 'ok') return 'bg-(--color-success)';
  if (state === 'degraded') return 'bg-amber-500';
  return 'bg-red-500';
};

const statusBgClass = (state: string) => {
  if (state === 'ok') return 'bg-(--color-success-bg) border-(--color-success-border)';
  if (state === 'degraded') return 'bg-amber-50 border-amber-200 dark:bg-amber-950/40 dark:border-amber-800';
  return 'bg-red-50 border-red-200 dark:bg-red-950/40 dark:border-red-800';
};

const statusTextClass = (state: string) => {
  if (state === 'ok') return 'text-(--color-success-text)';
  if (state === 'degraded') return 'text-amber-800 dark:text-amber-300';
  return 'text-red-800 dark:text-red-300';
};

/**
 * Three states, not two. "Unavailable" means the backend did not report the probe;
 * "Error" means it probed and failed. Collapsing the first into the second would claim a
 * measurement nobody took — and a missing probe is exactly when this page matters most.
 */
type BadgeState = 'ok' | 'error' | 'unavailable';

const badgeState = (probe: ServiceStatus | null): BadgeState => {
  if (!probe) return 'unavailable';
  return probe.status === 'ok' ? 'ok' : 'error';
};

const badgeDotClass = (state: BadgeState) => (state === 'ok' ? 'bg-(--color-success)' : 'bg-red-500');

const badgeTextClass = (state: BadgeState) =>
  state === 'ok' ? 'text-(--color-success-text)' : 'text-red-600 dark:text-red-400';

const badgeLabel = (state: BadgeState) => {
  if (state === 'ok') return t.pages.status.operational;
  if (state === 'error') return t.pages.status.error;
  return t.pages.status.unavailable;
};

// One row per probe, rendered by a single loop. The four rows used to be four copies of
// the same markup, which is also how the services read went wrong in three places at once.
const serviceRows: { key: string; title: string; description: string; state: BadgeState }[] = [
  {
    key: 'api',
    title: t.pages.status.api_server,
    description: t.pages.status.api_server_desc,
    // The document arrived, so the API answered: this row reports that, not a probe.
    state: health ? 'ok' : 'unavailable',
  },
  {
    key: 'ollama',
    title: t.pages.status.llm_runner,
    description: t.pages.status.llm_runner_desc,
    state: badgeState(serviceStatus(health, 'ollama')),
  },
  {
    key: 'database',
    title: t.pages.status.database,
    description: t.pages.status.database_desc,
    state: badgeState(serviceStatus(health, 'database')),
  },
  {
    key: 'qdrant',
    title: t.pages.status.vector_store,
    description: t.pages.status.vector_store_desc,
    state: badgeState(serviceStatus(health, 'qdrant')),
  },
];
---

<PublicLayout
  locale={locale}
  title={`${t.app.name} — ${t.pages.status.title}`}
  description={t.pages.status.description}
>
  <div class="mx-auto max-w-3xl px-4 py-4 md:px-8 lg:px-0 lg:py-8">
    <h1
      class="mb-8 text-3xl font-extrabold tracking-[-0.5px] text-(--color-text) md:text-4xl lg:text-5xl"
      style="font-family: 'Space Grotesk', sans-serif;"
    >
      {t.pages.status.title}
    </h1>

    <div class="space-y-6 text-base leading-[1.7] text-(--color-text-secondary) md:text-lg">
      <!-- Status indicator banner -->
      <div
        class={`flex items-center gap-3 rounded-lg border p-4 ${statusBgClass(bannerState)}`}>
        <span class="relative block h-3 w-3 shrink-0 rounded-full {statusDotClass(bannerState)}">
          <span
            class="absolute inline-flex h-3 w-3 animate-ping rounded-full {statusDotClass(bannerState)} opacity-75"
          />
        </span>
        <div>
          <p class={`font-semibold ${statusTextClass(bannerState)}`}>
            {bannerTitle}
          </p>
          <p class={`text-sm ${statusTextClass(bannerState)}`}>
            {bannerDesc}
          </p>
        </div>
      </div>

      <h2 class="text-xl font-bold text-(--color-text)">{t.pages.status.services_title}</h2>

      <div class="rounded-lg border border-(--color-border) divide-y divide-(--color-border)">
        {
          serviceRows.map((row) => (
            <div class="flex items-center justify-between p-4">
              <div>
                <p class="font-medium text-(--color-text)">{row.title}</p>
                <p class="text-sm text-(--color-text-secondary)">{row.description}</p>
              </div>
              <span
                class={`inline-flex items-center gap-1.5 text-sm font-medium ${badgeTextClass(row.state)}`}
              >
                <span class={`h-2 w-2 rounded-full ${badgeDotClass(row.state)}`} />
                {badgeLabel(row.state)}
              </span>
            </div>
          ))
        }
      </div>

      <p class="text-sm text-(--color-text-tertiary)">
        {t.pages.status.last_updated}: {health ? new Date(health.timestamp).toLocaleString(locale) : t.pages.status.checking}
      </p>
    </div>
  </div>
</PublicLayout>
