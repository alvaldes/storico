# ── Storico Backend Environment Variables ─────────────────────────
#
# REFERENCE DOCUMENT — do NOT copy this file.
#
# The backend reads from the repo-root `.env` via the symlink
#   backend/.env -> ../.env    (already exists, don't recreate)
#
# All vars use the STORICO_ prefix and are loaded by pydantic-settings.
# Defaults are shown below — only override what differs from defaults.
#
# No Celery, no Redis — background tasks run inline via asyncio.create_task.

# PostgreSQL (asyncpg)
# Local Docker: postgresql+asyncpg://storico:storico@localhost:5432/storico
# Neon:         postgresql+asyncpg://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# STORICO_DATABASE_URL=postgresql+asyncpg://storico:storico@localhost:5432/storico
# Logging — root level for application logs.
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL. An unknown name fails at startup.
# STORICO_LOG_LEVEL=INFO

# CORS — comma-separated allowed origins (dev, prod, preview)
# STORICO_AUTH_ALLOWED_ORIGINS=http://localhost:4321

# Auth — JWT secret (must match AUTH_SECRET from frontend .env)
# STORICO_AUTH_JWT_SECRET=dev-insecure-token-change-in-production

# Qdrant (vector store for RAG — optional, RAG disables gracefully if missing)
# STORICO_QDRANT_URL=http://localhost:6333
# STORICO_QDRANT_API_KEY=
# STORICO_QDRANT_COLLECTION=storico_extractions

# Embeddings (for RAG context retrieval)
# STORICO_OLLAMA_HOST is the Ollama server shared by extractions and embeddings.
# Inside Docker it must name the compose service, not localhost.
# STORICO_OLLAMA_HOST=http://localhost:11434
# STORICO_EMBEDDING_PROVIDER=ollama
# STORICO_EMBEDDING_MODEL=nomic-embed-text
# STORICO_EMBEDDING_DIMENSIONS=768

# Encryption — master key for workspace LLM credentials at rest (Fernet).
# Without it, saving a workspace credential answers 500 ENCRYPTION_KEY_MISSING.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORICO_ENCRYPTION_KEY=
