# ── Storico Environment Variables ──────────────────────────────────
#
# Copy this file to `.env` (same directory) and fill in the values.
# THIS IS THE SINGLE SOURCE OF TRUTH — both backend/ and frontend/ read
# from this file via symlinks (backend/.env -> ../.env, frontend/.env -> ../.env).
#
# Backend vars use prefix STORICO_ (pydantic-settings requirement).
# Frontend / Auth.js vars do NOT use the prefix.

## ── Backend (FastAPI — prefix STORICO_) ──────────────────────────

## PostgreSQL — uses asyncpg driver for async support.
## Local dev:     postgresql+asyncpg://storico:storico@localhost:5432/storico
## Neon:          postgresql+asyncpg://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
STORICO_DATABASE_URL=postgresql+asyncpg://storico:storico@localhost:5432/storico
## Logging — root level for application logs.
## One of: DEBUG | INFO | WARNING | ERROR | CRITICAL. An unknown name fails at startup.
STORICO_LOG_LEVEL=INFO

## CORS origins — comma-separated list of allowed origins
STORICO_AUTH_ALLOWED_ORIGINS=http://localhost:4321

## JWT secret — MUST match AUTH_SECRET below (used to verify proxy-generated JWTs)
# STORICO_AUTH_JWT_SECRET=

## Ollama — host of the LLM server that runs extractions. Inside Docker this must
## name the compose service (`http://storico-ollama:11434`); `localhost` would be
## the API container itself, and the model would be unreachable.
STORICO_OLLAMA_HOST=http://localhost:11434

## Qdrant — vector store for the RAG few-shot examples.
## Optional: if it is unreachable, retrieval degrades gracefully — extraction still
## runs, it just proceeds without few-shot context.
# STORICO_QDRANT_URL=http://localhost:6333
# STORICO_QDRANT_API_KEY=
# STORICO_QDRANT_COLLECTION=storico_extractions

## Embeddings — vectorizes user stories before the Qdrant search.
## STORICO_EMBEDDING_PROVIDER is exactly one of: ollama | google | openai
## (`google` and `openai` also require STORICO_GOOGLE_API_KEY / STORICO_OPENAI_API_KEY).
## The model MUST be a real embedding model, never a chat model: Ollama refuses chat
## models for embeddings. For the default provider run:  ollama pull nomic-embed-text
# STORICO_EMBEDDING_PROVIDER=ollama
# STORICO_EMBEDDING_MODEL=nomic-embed-text
# STORICO_EMBEDDING_DIMENSIONS=768

## Encryption — master key for workspace LLM credentials at rest (Fernet).
## Without it, saving a workspace credential answers 500 ENCRYPTION_KEY_MISSING.
## Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORICO_ENCRYPTION_KEY=

## ── Frontend (Astro — no prefix) ─────────────────────────────────

## Backend URL — used by Astro API proxy and Auth.js JWT callback
API_URL=http://127.0.0.1:8000

## Auth.js secret — generate with `openssl rand -base64 32`
## IMPORTANT: STORICO_AUTH_JWT_SECRET and AUTH_SECRET MUST be the same value.
# AUTH_SECRET=

## ── Auth.js OAuth providers ──────────────────────────────────────
## Google: https://console.cloud.google.com
## GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

## OAuth callback URL — only needed behind a reverse proxy (ngrok, tunnel, etc.)
## Otherwise auto-detected from the request Host header.
# AUTH_URL=
